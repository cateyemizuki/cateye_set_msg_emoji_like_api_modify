{
  "manifest_version": 2,
  "id": "github.cateye.set-msg-emoji-like",
  "version": "0.1.0",
  "name": "表情回应",
  "description": "对聊天消息贴 QQ 表情回应（reaction）：注册 LLM 工具让模型自然决定贴表情表达情绪或与群友交互（可替代 send_emoji）；同时把收到的表情回应通知翻译为可读文本注入框架。必需依赖 NapCat 适配器（maibot-team.napcat-adapter）提供 set_msg_emoji_like API；缺失时插件不会被加载。",
  "author": {
    "name": "cateye",
    "url": "https://github.com/cateyemizuki"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/cateyemizuki/cateye_set_msg_emoji_like_api_modify",
    "homepage": "https://github.com/cateyemizuki/cateye_set_msg_emoji_like_api_modify",
    "documentation": "https://github.com/cateyemizuki/cateye_set_msg_emoji_like_api_modify/blob/main/README.md",
    "issues": "https://github.com/cateyemizuki/cateye_set_msg_emoji_like_api_modify/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "plugin",
      "id": "maibot-team.napcat-adapter",
      "version_spec": ">=1.0.0"
    }
  ],
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "smile-plus"
    }
  },
  "capabilities": [
    "api.call",
    "maisaka.context.append",
    "message.get_by_time_in_chat"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
